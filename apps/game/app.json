{
  "expo": {
    "name": "Build Your Team",
    "slug": "build-your-team",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "buildyourteam",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.buildyourteam.app",
      "supportsTablet": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.buildyourteam.app",
      "adaptiveIcon": {
        "backgroundColor": "#06080B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Build Your Team",
      "shortName": "BYT",
      "themeColor": "#06080B",
      "backgroundColor": "#06080B"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06080B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-audio",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "backgroundColor": "#06080B",
    "description": "Jeu d'enchères multijoueur : composez la meilleure équipe avec le même budget que vos amis."
  }
}
