{
  "name": "build-your-team",
  "private": true,
  "version": "0.1.0",
  "description": "Build Your Team — Bid. Build. Win. Multiplayer team-building auction game.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @byt/realtime",
    "dev:web": "npm run web -w game",
    "test": "vitest run",
    "test:engine": "vitest run packages",
    "test:server": "vitest run services",
    "typecheck": "tsc -p packages/shared && tsc -p packages/game-engine && tsc -p packages/football && tsc -p services/realtime && tsc -p apps/game --noEmit",
    "data:demo": "tsx packages/football/scripts/generate-demo-dataset.ts",
    "data:import": "tsx packages/football/scripts/import-dataset.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
