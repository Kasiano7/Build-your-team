{
  "name": "build-your-team",
  "private": true,
  "version": "0.1.0",
  "description": "Build Your Team — Bid. Build. Win. Multiplayer team-building auction game.",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev -w @byt/realtime",
    "dev:web": "npm run web -w game",
    "test": "vitest run",
    "test:engine": "vitest run packages",
    "test:server": "vitest run services",
    "typecheck": "tsc -p packages/shared && tsc -p packages/game-engine && tsc -p packages/football && tsc -p packages/basketball && tsc -p packages/rugby && tsc -p packages/motorsport && tsc -p packages/arena && tsc -p services/realtime && tsc -p apps/game --noEmit",
    "data:real": "tsx packages/football/scripts/generate-real-dataset.ts",
    "data:basketball": "tsx packages/basketball/scripts/generate-real-dataset.ts",
    "data:rugby": "tsx packages/rugby/scripts/generate-real-dataset.ts",
    "data:motorsport": "tsx packages/motorsport/scripts/generate-real-dataset.ts",
    "data:arena": "tsx packages/arena/scripts/generate-heroes.ts",
    "data:import": "tsx packages/football/scripts/import-dataset.ts",
    "build:web": "npm run build:web -w game"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true
  }
}
